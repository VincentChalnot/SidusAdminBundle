{#
    The form of the create, edit, clone and read actions: neutral, semantic HTML, override the blocks to style it
    (or enable a theme, see the "theme" option).

    Variables: action, admin, form, data, listPath (null when the admin has no list action).
    Optional variables, the CSS class of an element: form_container_class, message_class, back_class, submit_class.

    Blocks:
        title         content of <title> (from base_template)
        container     the section of the action
          heading     the <h1>
            heading_text   its text
          form        the <form>
            message   the optional message above the fields
            form_actions   the buttons
              back_button
              submit_button
#}
{# @var action \Sidus\AdminBundle\Model\Action #}
{% extends action.baseTemplate %}

{% block title %}{{ block('heading_text') }}{% endblock %}

{% block container %}
    <section class="sidus-admin-action{% if form_container_class is defined %} {{ form_container_class }}{% endif %}" data-admin="{{ admin.code }}" data-action="{{ action.code }}">
        {{ block('heading') }}
        {{ block('form') }}
    </section>
{% endblock %}

{% block heading %}
    <h1>{{ block('heading_text') }}</h1>
{% endblock %}

{% block heading_text -%}
    {{ tryTrans(
        [
            'sidus.admin.'~admin.code~'.action.'~action.code~'.title',
            'sidus.admin.action.'~action.code~'.title'
        ], {
            '%entity%': data is defined ? data|tostring
        },
        admin.code|humanize~' - '~action.code|humanize,
        false
    ) }}
{%- endblock %}

{% block form %}
    {{ form_start(form) }}
        {{ block('message') }}
        {{ form_widget(form) }}
        {{ block('form_actions') }}
    {{ form_end(form) }}
{% endblock %}

{% block message %}
    {% set message = tryTrans(
        [
            'sidus.admin.'~admin.code~'.action.'~action.code~'.message',
            'sidus.admin.action.'~action.code~'.message',
        ], {
            '%entity%': data is defined ? data|tostring
        }
    ) %}
    {% if message %}
        <p class="sidus-admin-message{% if message_class is defined %} {{ message_class }}{% endif %}" role="{{ message_role|default('status') }}"{% if severity is defined %} data-severity="{{ severity }}"{% endif %}>
            {{ message }}
        </p>
    {% endif %}
{% endblock %}

{% block form_actions %}
    <p class="sidus-admin-actions">
        {{ block('back_button') }}
        {{ block('submit_button') }}
    </p>
{% endblock %}

{% block back_button %}
    {% if listPath|default(false) %}
        <a href="{{ listPath }}"{% if back_class is defined %} class="{{ back_class }}"{% endif %}>
            {{ tryTrans(
                [
                    'sidus.admin.'~admin.code~'.action.'~action.code~'.button.back',
                    'sidus.admin.action.'~action.code~'.button.back',
                    'sidus.admin.button.back',
                ],
                {},
                'Back',
                false
            ) }}
        </a>
    {% endif %}
{% endblock %}

{% block submit_button %}
    <button type="submit"{% if submit_class is defined %} class="{{ submit_class }}"{% endif %}{% if severity is defined %} data-severity="{{ severity }}"{% endif %}>
        {{ tryTrans(
            [
                'sidus.admin.'~admin.code~'.action.'~action.code~'.button.submit',
                'sidus.admin.action.'~action.code~'.button.submit',
                'sidus.admin.button.submit',
            ],
            {},
            'Submit',
            false
        ) }}
    </button>
{% endblock %}
